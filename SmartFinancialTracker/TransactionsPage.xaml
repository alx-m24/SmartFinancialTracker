<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SmartFinancialTracker.TransactionsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24,16,24,24" Spacing="20">

            <!-- Title & Quick Add -->
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Activity &amp; History" Style="{StaticResource Muted}" />
                    <Label Text="Transactions" Style="{StaticResource PageTitle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="+ Add" Clicked="QuickAddBtn_Clicked"
                        Style="{StaticResource PrimaryButton}" HeightRequest="40" Padding="14,0" VerticalOptions="Center" />
            </Grid>

            <!-- Financial Summary Cards -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <!-- Total Income Card -->
                <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Total Income" Style="{StaticResource Muted}" FontSize="12" />
                        <Label x:Name="TotalIncomeLabel" Text="$0.00" FontSize="20" FontAttributes="Bold" TextColor="#10B981" />
                    </VerticalStackLayout>
                </Border>

                <!-- Total Expenses Card -->
                <Border Grid.Column="1" BackgroundColor="{StaticResource CardBg}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Total Expenses" Style="{StaticResource Muted}" FontSize="12" />
                        <Label x:Name="TotalExpenseLabel" Text="$0.00" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Filter Chips (All / Expenses / Income) -->
            <HorizontalStackLayout Spacing="8">
                <Button x:Name="FilterAllBtn" Text="All" Clicked="FilterAll_Clicked" Style="{StaticResource SegOn}" HeightRequest="36" Padding="16,0" />
                <Button x:Name="FilterExpenseBtn" Text="Expenses" Clicked="FilterExpense_Clicked" Style="{StaticResource SegOff}" HeightRequest="36" Padding="16,0" />
                <Button x:Name="FilterIncomeBtn" Text="Income" Clicked="FilterIncome_Clicked" Style="{StaticResource SegOff}" HeightRequest="36" Padding="16,0" />
            </HorizontalStackLayout>

            <!-- Transaction History List -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Transaction Logs" Style="{StaticResource SectionTitle}" />

                <CollectionView x:Name="TransactionsListView" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="30" Spacing="8" HorizontalOptions="Center">
                            <Label Text="📄" FontSize="36" HorizontalOptions="Center" />
                            <Label Text="No transactions found." Style="{StaticResource Muted}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,8">
                                <Border Style="{StaticResource IconTile}" WidthRequest="42" HeightRequest="42">
                                    <Label Text="{Binding CategoryIcon}" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Description}" Style="{StaticResource Strong}" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Border Style="{StaticResource Chip}">
                                            <Label Text="{Binding CategoryName}" FontSize="11" TextColor="{StaticResource Brand}" />
                                        </Border>
                                        <Label Text="{Binding DisplayDate}" Style="{StaticResource Muted}" VerticalOptions="Center" FontSize="12" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding FormattedAmount}" Style="{StaticResource Strong}"
                                       TextColor="{Binding AmountColor}" VerticalOptions="Center" FontSize="16" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>