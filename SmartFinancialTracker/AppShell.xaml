<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="SmartFinancialTracker.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:SmartFinancialTracker"
       Shell.FlyoutBehavior="Disabled"
       Shell.TabBarBackgroundColor="{StaticResource Surface}"
       Shell.TabBarTitleColor="{StaticResource Brand}"
       Shell.TabBarUnselectedColor="{StaticResource TextMuted}">

    <!-- Starts on login; later: await Shell.Current.GoToAsync("//Main"); -->
    <ShellContent Route="Login" ContentTemplate="{DataTemplate local:LoginPage}" />

    <!-- Replaces the mock bottom bar. Add Icon="xyz.svg" to each tab once you have icons. -->
    <TabBar Route="Main">
        <ShellContent Title="Home" Route="Home" ContentTemplate="{DataTemplate local:HomePage}" />
        <ShellContent Title="Transactions" Route="Transactions" ContentTemplate="{DataTemplate local:TransactionsPage}" />
        <ShellContent Title="Savings" Route="Savings" ContentTemplate="{DataTemplate local:SavingGoalsPage}" />
        <ShellContent Title="Bills &amp; Reports" Route="Bills" ContentTemplate="{DataTemplate local:BillRemindersPage}" />
    </TabBar>
</Shell>
