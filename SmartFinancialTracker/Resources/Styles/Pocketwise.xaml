<?xml version="1.0" encoding="UTF-8" ?>
<!-- Put in Resources/Styles/ and merge in App.xaml:
     <ResourceDictionary Source="Resources/Styles/Pocketwise.xaml" />
     (after Colors.xaml / Styles.xaml) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Colours (the export had none, so this palette is my own - change freely) -->
    <Color x:Key="Brand">#0F766E</Color>
    <Color x:Key="BrandSoft">#E3F2EF</Color>
    <Color x:Key="PageBg">#F4F7F6</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Ink">#0F2A33</Color>
    <Color x:Key="OnInkMuted">#9FB3B0</Color>
    <Color x:Key="OnInkAccent">#5EEAD4</Color>
    <Color x:Key="TextMain">#14211F</Color>
    <Color x:Key="TextMuted">#5F6F6C</Color>
    <Color x:Key="Line">#E3E9E7</Color>
    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="DangerSoft">#FEE2E2</Color>
    <Color x:Key="Warn">#F59E0B</Color>
    <Color x:Key="WarnSoft">#FEF3C7</Color>
    <Color x:Key="WarnText">#92400E</Color>
    <Color x:Key="ChartBlue">#3B82F6</Color>
    <Color x:Key="ChartPink">#EC4899</Color>

    <!-- Text -->
    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextMain}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextMain}" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="TextColor" Value="{StaticResource Brand}" />
    </Style>
    <Style x:Key="Strong" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextMain}" />
    </Style>
    <Style x:Key="Muted" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
    </Style>
    <Style x:Key="Link" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Brand}" />
    </Style>

    <!-- Containers -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource Line}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="Field" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource Line}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandSoft}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
    </Style>
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandSoft}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 5" />
        <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style x:Key="SegmentTrack" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Line}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Brand}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="TextColor" Value="{StaticResource TextMain}" />
        <Setter Property="BorderColor" Value="{StaticResource Line}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>
    <Style x:Key="SmallButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Brand}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="27" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style x:Key="SegOn" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="TextColor" Value="{StaticResource Brand}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="SegOff" TargetType="Button" BasedOn="{StaticResource SegOn}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontAttributes" Value="None" />
    </Style>
    <Style x:Key="ChipOn" TargetType="Button" BasedOn="{StaticResource SegOn}">
        <Setter Property="BackgroundColor" Value="{StaticResource Brand}" />
        <Setter Property="TextColor" Value="White" />
    </Style>
    <Style x:Key="ChipOff" TargetType="Button" BasedOn="{StaticResource SegOn}">
        <Setter Property="BorderColor" Value="{StaticResource Line}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="TextColor" Value="{StaticResource TextMain}" />
    </Style>

    <Style x:Key="CurrencyChip" TargetType="RadioButton">
        <Setter Property="ControlTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="1"
                        Stroke="{StaticResource Line}"
                        BackgroundColor="{StaticResource Surface}"
                        HeightRequest="36">
                        <Label x:Name="ChipText" Text="{TemplateBinding Content}"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource TextMain}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CheckedStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource Brand}" />
                                            <Setter TargetName="ChipText" Property="Label.TextColor" Value="White" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Picker Default Style -->
    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource TextMain}" />
        <Setter Property="TitleColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
</ResourceDictionary>
