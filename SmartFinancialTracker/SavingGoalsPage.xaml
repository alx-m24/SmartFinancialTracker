<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SmartFinancialTracker.SavingGoalsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24,14,24,24" Spacing="12">

            <!-- Header -->
            <VerticalStackLayout Spacing="4">
                <Label Text="GROW YOUR FUTURE" Style="{StaticResource Eyebrow}" />
                <Label Text="Financial Planning&#10;&amp; Savings" Style="{StaticResource PageTitle}" />
            </VerticalStackLayout>

            <!-- AI insight -->
            <Border BackgroundColor="{StaticResource Ink}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 20" Padding="17">
                <VerticalStackLayout Spacing="11">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="✨ POCKETWISE AI" FontSize="11" FontAttributes="Bold" CharacterSpacing="1"
                               TextColor="{StaticResource OnInkAccent}" />
                        <Label Grid.Column="1" Text="Just for you" FontSize="12" TextColor="{StaticResource OnInkMuted}" />
                    </Grid>
                    <Label Text="💡 Smart Insight: You spent 20% less on food delivery this week! Tap to transfer $30 to your Emergency Fund."
                           FontSize="14" TextColor="White" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Put your progress to work" FontSize="13" FontAttributes="Bold"
                               TextColor="{StaticResource OnInkAccent}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="→" FontSize="18" TextColor="{StaticResource OnInkAccent}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Active goals -->
            <VerticalStackLayout Spacing="11">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Active goals" Style="{StaticResource SectionTitle}" />
                    <Label Grid.Column="1" Text="2 goals · $470 saved" Style="{StaticResource Muted}" VerticalOptions="Center" />
                </Grid>

                <Border Style="{StaticResource Card}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Style="{StaticResource IconTile}" WidthRequest="34" HeightRequest="34">
                                <Label Text="🛟" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Emergency Fund" Style="{StaticResource Strong}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="$350 / $500 saved" Style="{StaticResource Muted}" />
                            <Label Grid.Column="1" Text="70%" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Brand}" />
                        </Grid>
                        <ProgressBar Progress="0.7" ProgressColor="{StaticResource Brand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Style="{StaticResource IconTile}" WidthRequest="34" HeightRequest="34">
                                <Label Text="🏖️" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Summer Vacation" Style="{StaticResource Strong}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="$120 / $400 saved" Style="{StaticResource Muted}" />
                            <Label Grid.Column="1" Text="30%" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Brand}" />
                        </Grid>
                        <ProgressBar Progress="0.3" ProgressColor="{StaticResource Brand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Restricted savings -->
            <Border BackgroundColor="{StaticResource Line}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 14" Padding="16">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Text="🔒" FontSize="22" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="Monthly Restricted Savings" Style="{StaticResource Strong}" />
                        <Label Text="Unavailable funds · Locked until Nov 30" Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="$100" Style="{StaticResource Strong}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Button Text="+ Create New Savings Goal" Style="{StaticResource PrimaryButton}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
