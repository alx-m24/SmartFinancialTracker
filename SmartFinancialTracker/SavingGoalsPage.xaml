<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SmartFinancialTracker.SavingGoalsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24,14,24,24" Spacing="16">

            <!-- Header -->
            <VerticalStackLayout Spacing="4">
                <Label Text="GROW YOUR FUTURE" Style="{StaticResource Eyebrow}" />
                <Label Text="Financial Planning&#10;&amp; Savings" Style="{StaticResource PageTitle}" />
            </VerticalStackLayout>

            <!-- AI Insight -->
            <Border BackgroundColor="{StaticResource Ink}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 20" Padding="17">
                <VerticalStackLayout Spacing="11">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="✨ POCKETWISE AI" FontSize="11" FontAttributes="Bold" CharacterSpacing="1"
                               TextColor="{StaticResource OnInkAccent}" />
                        <Label Grid.Column="1" Text="Just for you" FontSize="12" TextColor="{StaticResource OnInkMuted}" />
                    </Grid>
                    <Label Text="💡 Smart Insight: You spent 20% less on food delivery this week! Tap to transfer $30 to your Emergency Fund."
                           FontSize="14" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <!-- Active Goals -->
            <VerticalStackLayout Spacing="11">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Active goals" Style="{StaticResource SectionTitle}" />
                    <Label x:Name="GoalsSummaryLabel" Text="0 goals · $0 saved" Style="{StaticResource Muted}" VerticalOptions="Center" />
                </Grid>

                <CollectionView x:Name="GoalsListView" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20" Spacing="6" HorizontalOptions="Center">
                            <Label Text="🎯" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="No savings goals created yet." Style="{StaticResource Muted}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Style="{StaticResource IconTile}" WidthRequest="34" HeightRequest="34">
                                            <Label Text="{Binding GoalIcon}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding GoalName}" Style="{StaticResource Strong}" VerticalOptions="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding DisplayProgress}" Style="{StaticResource Muted}" />
                                        <Label Grid.Column="1" Text="{Binding PercentInt, StringFormat='{0}%'}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Brand}" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding ProgressRatio}" ProgressColor="{StaticResource Brand}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Button Text="+ Create New Savings Goal" Clicked="CreateGoalBtn_Clicked" Style="{StaticResource PrimaryButton}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>