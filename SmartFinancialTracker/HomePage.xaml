<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SmartFinancialTracker.HomePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False">
    <Grid>
        <ScrollView>
            <!-- Bottom padding leaves room for the floating + button -->
            <VerticalStackLayout Padding="24,16,24,96" Spacing="18">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Make room for what matters." Style="{StaticResource Muted}" />
                        <Label x:Name="GreetingLabel" Text="Hello, Student! 👋" Style="{StaticResource PageTitle}" />
                    </VerticalStackLayout>
                    <Border BackgroundColor="{StaticResource BrandSoft}" StrokeThickness="0"
                            StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40"
                            VerticalOptions="Center" Grid.Column="1">
                        <Label x:Name="UserInitialsLabel" Text="ST" FontAttributes="Bold" TextColor="{StaticResource Brand}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Balance -->
                <Border BackgroundColor="{StaticResource Ink}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 20" Padding="20">
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Total balance" FontSize="13" TextColor="{StaticResource OnInkMuted}" />
                                <Label x:Name="BankDetailsLabel" Text="Primary Checking" FontSize="11" TextColor="{StaticResource OnInkMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="✓ Bank Linked" FontSize="12"
                                   TextColor="{StaticResource OnInkAccent}" VerticalOptions="Center" />
                        </Grid>
                        <Label x:Name="TotalBalanceLabel" Text="$0.00" FontSize="34" FontAttributes="Bold" TextColor="White" />
                        <Grid ColumnDefinitions="*,*" Margin="0,12,0,0">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="↗ Monthly income" FontSize="12" TextColor="{StaticResource OnInkMuted}" />
                                <Label x:Name="MonthlyIncomeLabel" Text="$0.00" FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource OnInkAccent}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="↘ Monthly spending" FontSize="12" TextColor="{StaticResource OnInkMuted}" />
                                <Label x:Name="MonthlySpendingLabel" Text="$0.00" FontSize="16" FontAttributes="Bold" TextColor="#FCA5A5" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Budget -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="11">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Monthly budget" Style="{StaticResource Strong}" />
                            <Label x:Name="CurrentMonthLabel" Text="Current Month" Style="{StaticResource Muted}" Grid.Column="1" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="BudgetProgressTextLabel" Text="$0 / $0 spent" Style="{StaticResource Muted}" />
                            <Label x:Name="BudgetPercentLabel" Text="0%" FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource WarnText}" Grid.Column="1" />
                        </Grid>
                        <ProgressBar x:Name="BudgetProgressBar" Progress="0.0" ProgressColor="{StaticResource Warn}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Alert (Shown dynamically when spending hits 80%+) -->
                <Border x:Name="BudgetAlertBorder" IsVisible="False" BackgroundColor="{StaticResource WarnSoft}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 14" Padding="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="⚠️" FontSize="20" VerticalOptions="Center" />
                        <Label x:Name="AlertTextLabel" Grid.Column="1" Text="Alert: You are approaching your monthly spending limit!"
                               FontSize="13" FontAttributes="Bold" TextColor="{StaticResource WarnText}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Recent transactions -->
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Recent Transactions" Style="{StaticResource SectionTitle}" />
                        <Label Grid.Column="1" Text="View all" Style="{StaticResource Link}" VerticalOptions="Center" />
                    </Grid>

                    <CollectionView x:Name="RecentTransactionsListView" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20" Spacing="8" HorizontalOptions="Center">
                                <Label Text="💸" FontSize="32" HorizontalOptions="Center" />
                                <Label Text="No transactions recorded yet." Style="{StaticResource Muted}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" HeightRequest="53">
                                    <Border Style="{StaticResource IconTile}" WidthRequest="38" HeightRequest="38">
                                        <Label Text="{Binding CategoryIcon}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                        <Label Text="{Binding Description}" Style="{StaticResource Strong}" />
                                        <HorizontalStackLayout Spacing="7">
                                            <Border Style="{StaticResource Chip}">
                                                <Label Text="{Binding CategoryName}" FontSize="11" TextColor="{StaticResource Brand}" />
                                            </Border>
                                            <Label Text="{Binding DisplayDate}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding FormattedAmount}" Style="{StaticResource Strong}"
                                           TextColor="{Binding AmountColor}" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Floating add button -->
        <Button x:Name="AddTransactionBtn" Clicked="AddTransactionBtn_Clicked" Text="+" FontSize="28" TextColor="White" BackgroundColor="{StaticResource Brand}"
                WidthRequest="56" HeightRequest="56" CornerRadius="28" Padding="0"
                HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,20">
            <Button.Shadow>
                <Shadow Brush="Black" Opacity="0.25" Radius="10" Offset="0,4" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>